@page "{id:int?}"
@model FormModel
@{
    var titulo = Model.EsEdicion ? "Editar área" : "Nuevo área";
    ViewData["Title"] = titulo;
    ViewData["Migas"] = new List<Miga> { new("Administración"), new("Áreas", "/Areas"), new(titulo) };
}

<div class="page-header"><h1>@titulo</h1></div>

<partial name="_Mensajes" />

<div class="nx-card nx-form">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Input.Nombre" class="form-label">Nombre</label>
                <input asp-for="Input.Nombre" class="form-control" />
                <span asp-validation-for="Input.Nombre" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Input.Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Descripcion" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="Input.Activo" class="form-check-input" role="switch" />
                    <label asp-for="Input.Activo" class="form-check-label">Área activa</label>
                </div>
            </div>
        </div>

        <div class="nx-form-acciones mt-4">
            <a asp-page="Index" class="btn btn-light">Cancelar</a>
            <button type="submit" class="btn btn-primary"
                    data-confirm="@(Model.EsEdicion ? "¿Desea guardar los cambios?" : "¿Desea registrar este área?")"
                    data-confirm-ok="@(Model.EsEdicion ? "Guardar" : "Registrar")">
                <i class="bi bi-save"></i> Guardar
            </button>
        </div>
    </form>
</div>
