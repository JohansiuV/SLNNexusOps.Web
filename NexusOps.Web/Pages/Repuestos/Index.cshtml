@page
@model IndexModel
@{
    ViewData["Title"] = "Repuestos";
    ViewData["Migas"] = new List<Miga> { new("Repuestos") };
}

<div class="page-header">
    <div>
        <h1>Repuestos</h1>
        <p class="subtitulo">Inventario de repuestos utilizados en los mantenimientos</p>
    </div>
    <a asp-page="Form" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo repuesto</a>
</div>

<partial name="_Mensajes" />

<div class="nx-card nx-filtros">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label class="form-label">Buscar</label>
            <input type="search" name="buscar" value="@Model.Buscar" class="form-control form-control-sm" placeholder="Nombre o descripción..." />
        </div>
        <div class="col-lg-3 col-md-6 d-flex align-items-center">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" name="soloStockBajo" value="true" id="chk_soloStockBajo" @(Model.SoloStockBajo ? "checked" : null) />
                <label class="form-check-label small" for="chk_soloStockBajo">Solo stock bajo</label>
            </div>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search"></i> Buscar</button>
            <a asp-page="Index" class="btn btn-light btn-sm">Limpiar</a>
        </div>
    </form>
</div>

<div class="nx-card sin-padding">
    @if (Model.Items.Count == 0)
    {
        <div class="nx-vacio"><i class="bi bi-box-seam"></i><p class="mt-2 mb-0">No se encontraron registros.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-nx">
                <thead><tr><th>Repuesto</th><th>Stock</th><th>Mínimo</th><th>Precio</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var x in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@x.Nombre<br /><small class="text-muted fw-normal">@x.Descripcion</small></td>
                            <td>@if (x.StockBajo) { <span class="badge text-bg-danger" title="Stock igual o menor al mínimo">@x.Stock</span> } else { <span class="badge text-bg-success">@x.Stock</span> }</td>
                            <td>@x.StockMinimo</td>
                            <td>@UiHelper.Moneda(x.Precio)</td>
                            <td>@if (x.Activo) { <span class="badge text-bg-success">Activo</span> } else { <span class="badge text-bg-secondary">Inactivo</span> }</td>
                            <td class="acciones">
                                <a asp-page="Form" asp-route-id="@x.IdRepuesto" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form method="post" asp-page-handler="Toggle" asp-route-id="@x.IdRepuesto">
                                    <button type="submit" class="btn btn-sm @(x.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                            title="@(x.Activo ? "Desactivar" : "Activar")"
                                            data-confirm="@(x.Activo ? "¿Desea desactivar este registro?" : "¿Desea activar este registro?")"
                                            data-confirm-ok="@(x.Activo ? "Desactivar" : "Activar")"
                                            data-confirm-clase="@(x.Activo ? "btn-danger" : "btn-success")">
                                        <i class="bi @(x.Activo ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Pag != null)
        {
            @await Html.PartialAsync("_Paginacion", Model.Pag)
        }
    }
</div>
