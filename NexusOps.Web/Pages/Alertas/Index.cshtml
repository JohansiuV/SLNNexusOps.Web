@page
@model IndexModel
@{
    ViewData["Title"] = "Alertas";
    ViewData["Migas"] = new List<Miga> { new("Alertas") };
}

<div class="page-header">
    <div>
        <h1>Alertas</h1>
        <p class="subtitulo">Generadas automáticamente por las reglas de negocio del sistema</p>
    </div>
    <form method="post" asp-page-handler="LeerTodas" class="m-0">
        <button type="submit" class="btn btn-outline-primary"
                data-confirm="¿Desea marcar todas las alertas como leídas?" data-confirm-ok="Marcar todas">
            <i class="bi bi-check2-all"></i> Marcar todas como leídas
        </button>
    </form>
</div>

<partial name="_Mensajes" />

<div class="nx-card nx-filtros">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">@await Html.PartialAsync("_FiltroSelect", new FiltroSelectInfo("nivel", "Nivel", Model.Nivel, Model.Niveles))</div>
        <div class="col-md-4 d-flex align-items-center gap-3">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" name="soloNoLeidas" value="true" id="chkNoLeidas" @(Model.SoloNoLeidas ? "checked" : null) />
                <label class="form-check-label small" for="chkNoLeidas">Solo no leídas</label>
            </div>
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search"></i> Filtrar</button>
            <a asp-page="Index" class="btn btn-light btn-sm">Limpiar</a>
        </div>
    </form>
</div>

<div class="nx-card sin-padding">
    @if (Model.Resultado.Items.Count == 0)
    {
        <div class="nx-vacio"><i class="bi bi-bell-slash"></i><p class="mt-2 mb-0">No hay alertas para mostrar.</p></div>
    }
    else
    {
        foreach (var a in Model.Resultado.Items)
        {
            var clase = UiHelper.ClaseNivelAlerta(a.Nivel);
            var enlace = UiHelper.EnlaceAlerta(a);
            <div class="nx-alerta-item @(a.Leida ? "" : "no-leida")">
                <i class="bi @UiHelper.IconoNivel(a.Nivel) icono @clase"></i>
                <div class="texto">
                    <div class="@(a.Leida ? "text-muted" : "fw-semibold")">@UiHelper.EmojiNivel(a.Nivel) @a.Mensaje</div>
                    <small class="text-muted">@UiHelper.FechaHora(a.FechaRegistro)</small>
                </div>
                <div class="d-flex gap-2">
                    @if (enlace != null)
                    {
                        <a href="@enlace" class="btn btn-sm btn-outline-primary">Ver</a>
                    }
                    @if (!a.Leida)
                    {
                        <form method="post" asp-page-handler="Leer" asp-route-id="@a.IdAlerta" asp-route-soloNoLeidas="@(Model.SoloNoLeidas ? "true" : null)" asp-route-nivel="@Model.Nivel" class="m-0">
                            <button type="submit" class="btn btn-sm btn-light" title="Marcar como leída"><i class="bi bi-check2"></i></button>
                        </form>
                    }
                </div>
            </div>
        }
        @await Html.PartialAsync("_Paginacion", new PaginacionInfo(Model.Resultado.Pagina, Model.Resultado.TotalPaginas, Model.Resultado.Total, Model.Resultado.Tamano))
    }
</div>
