@page
@model IndexModel
@{
    ViewData["Title"] = "Activos";
    ViewData["Migas"] = new List<Miga> { new("Activos") };
}

<div class="page-header">
    <div>
        <h1>Activos</h1>
        <p class="subtitulo">Inventario y ciclo de vida de los activos de la organización</p>
    </div>
    @if (Model.EsAdminOSupervisor)
    {
        <a asp-page="Form" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo activo</a>
    }
</div>

<partial name="_Mensajes" />

<div class="nx-card nx-filtros">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-lg-3 col-md-6">
            <label class="form-label">Buscar</label>
            <input type="search" name="buscar" value="@Model.Buscar" class="form-control form-control-sm" placeholder="Código, nombre, marca, serie..." />
        </div>
        <div class="col-lg-2 col-md-6">@await Html.PartialAsync("_FiltroSelect", new FiltroSelectInfo("idArea", "Área", Model.IdArea?.ToString(), Model.Areas))</div>
        <div class="col-lg-2 col-md-6">@await Html.PartialAsync("_FiltroSelect", new FiltroSelectInfo("idTipoActivo", "Tipo", Model.IdTipoActivo?.ToString(), Model.Tipos))</div>
        <div class="col-lg-2 col-md-6">@await Html.PartialAsync("_FiltroSelect", new FiltroSelectInfo("estado", "Estado", Model.Estado, Model.Estados))</div>
        <div class="col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search"></i> Buscar</button>
            <a asp-page="Index" class="btn btn-light btn-sm">Limpiar</a>
        </div>
    </form>
</div>

<div class="nx-card sin-padding">
    @if (Model.Resultado.Items.Count == 0)
    {
        <div class="nx-vacio"><i class="bi bi-pc-display"></i><p class="mt-2 mb-0">No se encontraron activos.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-nx">
                <thead>
                    <tr><th>Código</th><th>Activo</th><th>Tipo</th><th>Área</th><th>Marca / Modelo</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Resultado.Items)
                    {
                        <tr>
                            <td><a asp-page="Detalle" asp-route-id="@a.IdActivo" class="fw-semibold text-mono">@a.Codigo</a></td>
                            <td>@a.Nombre</td>
                            <td>@a.TipoActivo</td>
                            <td>@a.Area</td>
                            <td>@a.Marca @a.Modelo</td>
                            <td><span class="badge @UiHelper.ClaseEstado(a.Estado)">@a.Estado</span></td>
                            <td class="acciones">
                                <a asp-page="Detalle" asp-route-id="@a.IdActivo" class="btn btn-sm btn-outline-primary" title="Ver ficha"><i class="bi bi-eye"></i></a>
                                @if (Model.EsAdminOSupervisor && a.Estado != EstadosActivo.DadoDeBaja)
                                {
                                    <a asp-page="Form" asp-route-id="@a.IdActivo" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                                }
                                @if (Model.EsAdministrador && a.Estado != EstadosActivo.DadoDeBaja)
                                {
                                    <form method="post" asp-page-handler="Baja" asp-route-id="@a.IdActivo">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Dar de baja"
                                                data-confirm="¿Desea dar de baja el activo @a.Codigo? Esta acción no se puede revertir."
                                                data-confirm-ok="Dar de baja" data-confirm-clase="btn-danger">
                                            <i class="bi bi-archive"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Paginacion", new PaginacionInfo(Model.Resultado.Pagina, Model.Resultado.TotalPaginas, Model.Resultado.Total, Model.Resultado.Tamano))
    }
</div>
