@page
@model IndexModel
@{
    ViewData["Title"] = "Tareas";
    ViewData["Migas"] = new List<Miga> { new("Tareas") };
}

<div class="page-header">
    <div>
        <h1>Tareas</h1>
        <p class="subtitulo">@(Model.EsTecnico ? "Tareas asignadas a usted" : "Seguimiento de tareas operativas y control de vencimientos")</p>
    </div>
    @if (Model.EsAdminOSupervisor)
    {
        <a asp-page="Form" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nueva tarea</a>
    }
</div>

<partial name="_Mensajes" />

<div class="nx-card nx-filtros">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-lg-3 col-md-6">
            <label class="form-label">Buscar</label>
            <input type="search" name="buscar" value="@Model.Buscar" class="form-control form-control-sm" placeholder="Código o título..." />
        </div>
        <div class="col-lg-2 col-md-6">@await Html.PartialAsync("_FiltroSelect", new FiltroSelectInfo("estado", "Estado", Model.Estado, Model.Estados))</div>
        <div class="col-lg-2 col-md-6">@await Html.PartialAsync("_FiltroSelect", new FiltroSelectInfo("prioridad", "Prioridad", Model.Prioridad, Model.Prioridades))</div>
        @if (Model.EsAdminOSupervisor)
        {
            <div class="col-lg-3 col-md-6">@await Html.PartialAsync("_FiltroSelect", new FiltroSelectInfo("idUsuarioAsignado", "Responsable", Model.IdUsuarioAsignado?.ToString(), Model.Usuarios))</div>
        }
        <div class="col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search"></i> Buscar</button>
            <a asp-page="Index" class="btn btn-light btn-sm">Limpiar</a>
        </div>
    </form>
</div>

<div class="nx-card sin-padding">
    @if (Model.Resultado.Items.Count == 0)
    {
        <div class="nx-vacio"><i class="bi bi-check2-square"></i><p class="mt-2 mb-0">No se encontraron tareas.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-nx">
                <thead>
                    <tr><th>Código</th><th>Tarea</th><th>Responsable</th><th>Prioridad</th><th>Inicio</th><th>Vence</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Resultado.Items)
                    {
                        var acciones = FlujoEstadosUi.Tarea(t.EstadoRegistrado, Model.EsTecnico);
                        <tr class="@(t.Vencida ? "fila-alerta" : "")">
                            <td class="text-mono fw-semibold">@t.Codigo</td>
                            <td>@t.Titulo@if (!string.IsNullOrEmpty(t.Descripcion)) { <br /><small class="text-muted">@t.Descripcion</small> }</td>
                            <td>@t.UsuarioAsignado</td>
                            <td><span class="badge @UiHelper.ClasePrioridad(t.Prioridad)">@UiHelper.Texto(t.Prioridad)</span></td>
                            <td>@UiHelper.Fecha(t.FechaInicio)</td>
                            <td class="@(t.Vencida ? "text-danger fw-semibold" : "")">@UiHelper.Fecha(t.FechaVencimiento)</td>
                            <td>
                                @if (t.Vencida)
                                {
                                    <span class="badge text-bg-danger" title="Estado registrado: @t.EstadoRegistrado">Vencida</span>
                                }
                                else
                                {
                                    <span class="badge @UiHelper.ClaseEstado(t.Estado)">@t.Estado</span>
                                }
                            </td>
                            <td class="acciones">
                                @foreach (var destino in acciones)
                                {
                                    <button type="button" class="btn btn-sm @(destino == EstadosTarea.Cancelada ? "btn-outline-danger" : (destino == EstadosTarea.Completada ? "btn-outline-success" : "btn-outline-primary"))"
                                            title="@FlujoEstadosUi.Accion(destino)"
                                            data-bs-toggle="modal" data-bs-target="#modalEstado"
                                            data-id="@t.IdTarea" data-estado="@destino"
                                            data-titulo="@FlujoEstadosUi.Accion(destino) tarea @t.Codigo"
                                            data-texto="@(destino == EstadosTarea.Cancelada ? "Indique el motivo de la cancelación." : "¿Desea continuar?")"
                                            data-boton="@FlujoEstadosUi.Accion(destino)" data-clase="@FlujoEstadosUi.ClaseBoton(destino)"
                                            data-requiere-comentario="@(destino == EstadosTarea.Cancelada ? "1" : "0")">
                                        <i class="bi @FlujoEstadosUi.Icono(destino)"></i>
                                    </button>
                                }
                                @if (Model.EsAdminOSupervisor && EstadosTarea.SinCompletar.Contains(t.EstadoRegistrado))
                                {
                                    <a asp-page="Form" asp-route-id="@t.IdTarea" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Paginacion", new PaginacionInfo(Model.Resultado.Pagina, Model.Resultado.TotalPaginas, Model.Resultado.Total, Model.Resultado.Tamano))
    }
</div>

<partial name="_ModalEstado" model="@(new ModalEstadoInfo("Estado", null))" />
