@page "{id:int?}"
@model FormModel
@{
    var titulo = Model.EsEdicion ? "Editar tarea" : "Nueva tarea";
    ViewData["Title"] = titulo;
    ViewData["Migas"] = new List<Miga> { new("Tareas", "/Tareas"), new(titulo) };
}

<div class="page-header"><h1>@titulo</h1></div>

<partial name="_Mensajes" />

<div class="nx-card nx-form">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Input.Titulo" class="form-label">Título</label>
                <input asp-for="Input.Titulo" class="form-control" />
                <span asp-validation-for="Input.Titulo" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Input.Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Descripcion" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.IdUsuarioAsignado" class="form-label">Responsable</label>
                <select asp-for="Input.IdUsuarioAsignado" asp-items="Model.Usuarios" class="form-select"><option value="0">-- Seleccione --</option></select>
                <span asp-validation-for="Input.IdUsuarioAsignado" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Prioridad" class="form-label">Prioridad</label>
                <select asp-for="Input.Prioridad" asp-items="Model.Prioridades" class="form-select"></select>
                <span asp-validation-for="Input.Prioridad" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.FechaInicio" class="form-label">Fecha de inicio</label>
                <input asp-for="Input.FechaInicio" class="form-control" />
                <span asp-validation-for="Input.FechaInicio" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.FechaVencimiento" class="form-label">Fecha de vencimiento</label>
                <input asp-for="Input.FechaVencimiento" class="form-control" />
                <span asp-validation-for="Input.FechaVencimiento" class="text-danger"></span>
            </div>
        </div>

        <div class="nx-form-acciones mt-4">
            <a asp-page="Index" class="btn btn-light">Cancelar</a>
            <button type="submit" class="btn btn-primary"
                    data-confirm="@(Model.EsEdicion ? "¿Desea guardar los cambios de la tarea?" : "¿Desea registrar esta tarea?")"
                    data-confirm-ok="@(Model.EsEdicion ? "Guardar" : "Registrar")">
                <i class="bi bi-save"></i> Guardar
            </button>
        </div>
    </form>
</div>
