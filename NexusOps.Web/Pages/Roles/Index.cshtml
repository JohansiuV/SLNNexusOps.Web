@page
@model IndexModel
@{
    ViewData["Title"] = "Roles y permisos";
    ViewData["Migas"] = new List<Miga> { new("Administración"), new("Roles") };

    // Matriz de acceso (refleja las reglas de autorización de la API).
    var matriz = new (string Modulo, string Admin, string Sup, string Tec)[]
    {
        ("Dashboard", "Total", "Consulta", "—"),
        ("Usuarios y roles", "Total", "—", "—"),
        ("Áreas, personal y tipos de activo", "Total", "—", "—"),
        ("Activos", "Total (baja solo Admin)", "Registrar y editar", "Consulta"),
        ("Incidencias", "Total", "Total", "Registrar; atender las asignadas"),
        ("Tareas", "Total", "Total", "Solo las asignadas"),
        ("Mantenimientos", "Total", "Total", "Solo los asignados"),
        ("Repuestos", "Total", "Total", "Consulta"),
        ("Alertas", "Todas", "Todas", "Solo las propias"),
        ("Reportes", "Total", "Total", "—")
    };
}

<div class="page-header">
    <div>
        <h1>Roles y permisos</h1>
        <p class="subtitulo">Los roles son fijos; el acceso se controla en la API por medio del token JWT</p>
    </div>
</div>

<partial name="_Mensajes" />

<div class="row g-3 mb-3">
    @foreach (var rol in Model.Roles)
    {
        <div class="col-md-4">
            <div class="nx-card h-100">
                <h5><i class="bi bi-shield-lock text-primary"></i> @rol.Nombre</h5>
                <p class="text-muted">@rol.Descripcion</p>
                <span class="badge text-bg-light border"><i class="bi bi-people"></i> @rol.TotalUsuarios usuario(s)</span>
                @if (!rol.Activo) { <span class="badge text-bg-secondary">Inactivo</span> }
            </div>
        </div>
    }
</div>

<div class="nx-card sin-padding">
    <div class="table-responsive">
        <table class="table table-nx">
            <thead><tr><th>Módulo</th><th>Administrador</th><th>Supervisor</th><th>Técnico</th></tr></thead>
            <tbody>
                @foreach (var f in matriz)
                {
                    <tr>
                        <td class="fw-semibold">@f.Modulo</td>
                        <td>@f.Admin</td>
                        <td>@f.Sup</td>
                        <td>@f.Tec</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
